{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "product-engineer",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.claude\"; C=$(cat \"$CLAUDE_PROJECT_DIR/.claude/.pending-qa-count\" 2>/dev/null || echo 0); echo $((C + 1)) > \"$CLAUDE_PROJECT_DIR/.claude/.pending-qa-count\""
          }
        ]
      },
      {
        "matcher": "qa",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-qa-result.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-qa.sh"
          }
        ]
      }
    ]
  }
}
