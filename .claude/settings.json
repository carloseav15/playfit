{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "product-engineer",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.claude/.pending-qa\" && mktemp \"$CLAUDE_PROJECT_DIR/.claude/.pending-qa/run.XXXXXX\" > /dev/null"
          }
        ]
      },
      {
        "matcher": "qa",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-qa-result.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-qa.sh"
          }
        ]
      }
    ]
  }
}
